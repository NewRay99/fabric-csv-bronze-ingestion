table 'Offer Location Paths'
	lineageTag: 397bd503-d6c2-51c4-a6ac-ea8ae1749df0

	measure 'Map connection visible' =
			IF (
			    HASONEVALUE ( 'fact_offer'[referral_id] )
			        && NOT ISBLANK ( SELECTEDVALUE ( 'fact_offer'[referral_id] ) ),
			    1
			)
		formatString: 0
		displayFolder: Offer locations
		lineageTag: a14d16b4-58a6-5a1d-9837-cc2e841aec65

	measure 'Map connection summary' =
			VAR selectedReferrals =
			    COUNTROWS ( FILTER ( VALUES ( 'fact_offer'[referral_id] ), NOT ISBLANK ( 'fact_offer'[referral_id] ) ) )
			VAR selectedOffers = COALESCE ( DISTINCTCOUNTNOBLANK ( 'fact_offer'[offer_id] ), 0 )
			VAR mappedOffers = COALESCE ( DISTINCTCOUNTNOBLANK ( 'Offer Location Paths'[Offer ID] ), 0 )
			VAR defaultOffers =
			    COALESCE ( CALCULATE ( DISTINCTCOUNTNOBLANK ( 'Offer Location Paths'[Offer ID] ),
			        'Offer Location Paths'[Location quality] = "Default-city estimate" ), 0 )
			RETURN
			    SWITCH ( TRUE (),
			        selectedOffers = 0, "No offers match these filters.",
			        selectedReferrals <> 1, "Select one referral above, or an offer row, to show its connections.",
			        mappedOffers = 0, "No connection available: endpoint coordinates are missing or the location needs review.",
			        FORMAT ( mappedOffers, "#,0" ) & " of " & FORMAT ( selectedOffers, "#,0" ) & " offers mapped"
			            & IF ( defaultOffers > 0, " | " & FORMAT ( defaultOffers, "#,0" ) & " use a default city", "" )
			            & IF ( selectedOffers > mappedOffers, " | " & FORMAT ( selectedOffers - mappedOffers, "#,0" ) & " unavailable / review", "" )
			    )
		displayFolder: Offer locations
		lineageTag: 2e9f77a6-93d9-510a-9776-a811807212b6

	measure 'Connection referral' = SELECTEDVALUE ( 'Offer Location Paths'[Referral ID] )
		displayFolder: Offer locations/Tooltips
		lineageTag: 4dcf92f6-c9ab-5575-b2ea-2daa40e3c07c

	measure 'Connection city' = SELECTEDVALUE ( 'Offer Location Paths'[Referral city] )
		displayFolder: Offer locations/Tooltips
		lineageTag: 9d04b705-6177-5230-87e6-451b0b371a91

	measure 'Connection postcode' = SELECTEDVALUE ( 'Offer Location Paths'[Home postcode] )
		displayFolder: Offer locations/Tooltips
		lineageTag: ab2abade-cf17-54e2-b809-65591f1cb933

	measure 'Connection provider' = SELECTEDVALUE ( 'Offer Location Paths'[Provider] )
		displayFolder: Offer locations/Tooltips
		lineageTag: a59ed3d0-8056-5e2a-9670-5ce7e17945e9

	measure 'Connection home' = SELECTEDVALUE ( 'Offer Location Paths'[Home] )
		displayFolder: Offer locations/Tooltips
		lineageTag: 40c3fb54-f676-55a7-a310-91f37ed63407

	measure 'Connection offer status' = SELECTEDVALUE ( 'Offer Location Paths'[Offer status] )
		displayFolder: Offer locations/Tooltips
		lineageTag: 2dfaaace-2528-582c-9287-5ab985fb5e92

	measure 'Connection endpoint' = SELECTEDVALUE ( 'Offer Location Paths'[Endpoint type] )
		displayFolder: Offer locations/Tooltips
		lineageTag: f40ae7c9-a791-57c4-a0a3-126cbdbb589f

	measure 'Connection quality' = SELECTEDVALUE ( 'Offer Location Paths'[Location quality] )
		displayFolder: Offer locations/Tooltips
		lineageTag: da406637-d270-577a-a9ec-5de70b6ca0f5

	measure 'Connection straight-line km' = SELECTEDVALUE ( 'Offer Location Paths'[Distance km] )
		formatString: 0.0" km"
		displayFolder: Offer locations/Tooltips
		lineageTag: a161695e-114b-5966-ad93-36a89bda9fd1

