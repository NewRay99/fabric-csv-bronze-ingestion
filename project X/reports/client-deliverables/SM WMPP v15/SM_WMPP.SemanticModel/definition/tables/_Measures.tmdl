	measure 'Pending Offers 0-7 Days' = ```

			CALCULATE (
			    [Pending Offers],
			    FILTER (
			        'fact_offer',
			        DATEDIFF (
			            COALESCE ( 'fact_offer'[offer_reviewed_date], 'fact_offer'[offer_submitted_date] ),
			            TODAY (), DAY
			        ) <= 7
			    )
			)

			```
		formatString: 0
		lineageTag: 04390d78-9b1a-4ba0-bf6d-2c7733bffa39

	measure 'Pending Offers 8-14 Days' = ```

			CALCULATE (
			    [Pending Offers],
			    FILTER (
			        'fact_offer',
			        VAR age_days = DATEDIFF (
			            COALESCE ( 'fact_offer'[offer_reviewed_date], 'fact_offer'[offer_submitted_date] ),
			            TODAY (), DAY
			        )
			        RETURN age_days >= 8 && age_days <= 14
			    )
			)

			```
		formatString: 0
		lineageTag: f286d979-6b1e-4a49-b0b5-6d2244c83ce1

	measure 'Pending Offers 15-29 Days' = ```

			CALCULATE (
			    [Pending Offers],
			    FILTER (
