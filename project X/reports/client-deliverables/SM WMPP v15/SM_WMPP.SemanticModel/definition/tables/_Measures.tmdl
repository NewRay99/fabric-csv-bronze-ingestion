			        && COUNTROWS(rpt_provider_registry) = 0

			RETURN
			SWITCH(
			    TRUE(),

			    -- Fostering view → only show fostering
			    IsFostering && SelectedType = "Fostering Providers",
			        [Fostering Providers],

			    IsFostering,
			        BLANK(),

			    -- SA/Resi view → only show homes
			    SelectedType = "Residential Homes",
			        [Residential Homes],

			    SelectedType = "Supported Accommodation Homes",
			        [Supported Accommodation Homes],

