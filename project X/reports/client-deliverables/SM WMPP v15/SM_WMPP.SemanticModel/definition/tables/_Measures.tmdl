table _Measures
	lineageTag: 712bae27-868f-4173-abe7-64ce2ab38422

	measure 'Total Referrals' = ```

			DISTINCTCOUNT ( 'fact_referral'[referral_id] )

			```
		formatString: 0
		lineageTag: 662cadd2-ad4e-4511-8f5a-f2860f5819cd

	measure 'Open Referrals' = ```

			CALCULATE ( [Total Referrals], 'fact_referral'[is_open] = TRUE () )

			```
		formatString: 0
		lineageTag: 85fc7ff8-ca80-4461-96f1-dbfdc9077b70

	measure 'Closed Referrals' = ```

			CALCULATE ( [Total Referrals], 'fact_referral'[is_open] = FALSE () )

			```
		formatString: 0
		lineageTag: c63f83aa-e655-4bba-851c-e547032b4108

	measure 'Referrals With an Offer' = ```

			CALCULATE ( [Total Referrals], 'fact_referral'[has_offer] = TRUE () )

			```
		formatString: 0
		lineageTag: f7ca56a2-2308-47e0-9846-73125d17c228

	measure 'Referrals Awaiting Offer' = ```

			CALCULATE (
			    [Total Referrals],
			    'fact_referral'[is_open] = TRUE (),
			    'fact_referral'[has_offer] = FALSE ()
			)

			```
		formatString: 0
		lineageTag: 006605db-9bbb-4c0c-adce-c0c334d42a4e

	measure 'Referrals Without Provider Assignment' = ```

			CALCULATE ( [Total Referrals], 'fact_referral'[is_not_seen_by_providers] = TRUE () )

			```
		formatString: 0
		lineageTag: d8b2335e-e9c6-4ef9-a260-a786f8d5e347

	measure 'Open Overdue Referrals' = ```

			CALCULATE (
			    [Total Referrals],
			    FILTER (
			        'fact_referral',
			        'fact_referral'[is_open] = TRUE ()
			            && NOT ISBLANK ( 'fact_referral'[required_placement_date] )
			            && 'fact_referral'[required_placement_date] < 'fact_referral'[as_of_date]
			    )
			)

			```
		formatString: 0
		lineageTag: d9d07af1-cf5a-411a-b893-2d8e209fa3d5

	measure 'Referrals Placed by Required Date' = ```

			CALCULATE ( [Total Referrals], 'fact_referral'[placed_by_required_date] = TRUE () )

			```
		formatString: 0
		lineageTag: 5465a86a-c724-4e11-9170-daa87578ba3b

	measure 'Placement Target Hit Rate' = ```

			DIVIDE (
			    [Referrals Placed by Required Date],
			    CALCULATE (
			        [Total Referrals],
			        FILTER (
			            'fact_referral',
			            NOT ISBLANK ( 'fact_referral'[ipa_issued_date] )
			                && NOT ISBLANK ( 'fact_referral'[required_placement_date] )
			        )
			    )
			)

			```
		formatString: 0.0%
		lineageTag: 03c5b503-527b-4345-aeaf-ec3c9da2a28d

	measure 'Median Days to First Action' = ```

			MEDIANX (
			    FILTER ( 'fact_referral', NOT ISBLANK ( 'fact_referral'[days_to_first_action] ) ),
			    'fact_referral'[days_to_first_action]
			)

			```
		formatString: 0
		lineageTag: 86cb68d0-6f1e-48f6-928a-fecf5ac7ad0a

	measure 'Median Days to First Offer' = ```

			MEDIANX (
			    FILTER ( 'fact_referral', NOT ISBLANK ( 'fact_referral'[days_to_first_offer] ) ),
			    'fact_referral'[days_to_first_offer]
			)

			```
		formatString: 0
		lineageTag: fcd1158b-4fdd-4a9d-9d15-42ea5e24a940

	measure 'Median Days to IPA' = ```

			MEDIANX (
			    FILTER ( 'fact_referral', NOT ISBLANK ( 'fact_referral'[days_to_ipa] ) ),
			    'fact_referral'[days_to_ipa]
			)

			```
		formatString: 0
		lineageTag: 4933e02f-f98d-46c1-bc7c-9b2db52c30af

	measure 'Open Referrals Stalled 7+ Days' = ```

			CALCULATE (
			    [Total Referrals],
			    FILTER ( 'fact_referral', 'fact_referral'[is_open] = TRUE () && 'fact_referral'[days_without_activity] >= 7 )
			)

			```
		formatString: 0
		lineageTag: 80f96a85-1a26-4ddb-9328-9c84ab3fc730

	measure 'Offers Submitted' = ```

			DISTINCTCOUNT ( 'fact_offer'[offer_id] )

			```
		formatString: 0
		lineageTag: f33eacb5-6d66-4d96-83f9-72db36ec51a1

	measure 'Accepted Offers' = ```

			CALCULATE (
			    [Offers Submitted],
			    FILTER (
			        'fact_offer',
			        LOWER ( 'fact_offer'[offer_status] ) IN { "accepted", "approved", "selected", "offer_successful" }
			    )
			)

			```
		formatString: 0
		lineageTag: 3d4f5737-c34b-48fa-96cb-0bd35cc7b235

	measure 'Offers with a Decision' = ```

			CALCULATE (
			    [Offers Submitted],
			    FILTER ( 'fact_offer', NOT ISBLANK ( 'fact_offer'[offer_decision_date] ) )
			)

			```
		formatString: 0
		lineageTag: 27ff90b8-bd9f-4c8a-b0ff-1eb94bcf54a4

	measure 'Offer Acceptance Rate' = ```

			DIVIDE ( [Accepted Offers], [Offers with a Decision] )

			```
		formatString: 0.0%
		lineageTag: ea6609b1-45b1-4abc-b388-36addbd889b1

	measure 'Average Offers per Referral' = ```

			DIVIDE ( [Offers Submitted], [Referrals With an Offer] )

			```
		formatString: 0
		lineageTag: de445b98-7e48-419a-ac0c-f417aae67787

	measure 'Offers in Draft' = ```

			CALCULATE ( [Offers Submitted], LOWER ( 'fact_offer'[offer_status] ) = "draft" )

			```
		formatString: 0
		lineageTag: ce6fa1a7-88e7-4e50-b8a7-5068f9115f5e

	measure 'Draft Offers Stalled 7+ Days' = ```

			CALCULATE (
			    [Offers Submitted],
			    FILTER (
			        'fact_offer',
			        LOWER ( 'fact_offer'[offer_status] ) = "draft"
			            && DATEDIFF ( 'fact_offer'[offer_reviewed_date], TODAY (), DAY ) >= 7
			    )
			)

			```
		formatString: 0
		lineageTag: ade8baee-491d-4535-b2cb-0e76f8ac36a5

	measure 'IPAs Created' = ```

