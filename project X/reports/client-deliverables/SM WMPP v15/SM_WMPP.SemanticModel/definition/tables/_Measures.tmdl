	measure 'Estimated Active Weekly Cost' = ```

			CALCULATE (
			    SUM ( 'fct_ipa'[estimated_weekly_cost] ),
			    'fct_ipa'[is_placement_closed] = FALSE ()
			)

			```
		formatString: 0.00
		lineageTag: 540ea0fd-32f2-46d5-9492-bd37bf2fcd4a

	measure 'Average Estimated Weekly Cost — Confirmed Referrals' = ```

			AVERAGEX (
			    FILTER (
			        'fact_referral',
			        NOT ISBLANK ( 'fact_referral'[ipa_issued_date] )
			            && NOT ISBLANK ( 'fact_referral'[estimated_weekly_cost] )
			    ),
			    'fact_referral'[estimated_weekly_cost]
			)

			```
		formatString: 0.00
		lineageTag: a5985d26-f807-42e9-aa95-fd7e1007fda9

