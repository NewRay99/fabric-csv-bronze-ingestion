	measure 'Referrals Created Previous Month' = ```

			CALCULATE ( [Total Referrals], DATEADD ( 'dim_date'[date], -1, MONTH ) )

			```
		formatString: 0
		lineageTag: b0bf8644-a225-4005-9421-6dc16daecdd6

	measure 'Referral Volume Month on Month' = ```

