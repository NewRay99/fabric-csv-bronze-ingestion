	measure 'Closed Referrals at Snapshot' =

			CALCULATE (
			    [Snapshot Referrals],
			    FILTER (
			        'Fact Referral Snapshot',
			        NOT ISBLANK ( 'Fact Referral Snapshot'[ReferralClosedDate] )
			            && 'Fact Referral Snapshot'[ReferralClosedDate] < 'Fact Referral Snapshot'[SnapshotDate] + 1
