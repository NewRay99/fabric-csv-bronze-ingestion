	measure 'Draft Offers With No Activity Since Creation' = ```

			CALCULATE (
			    [Offers Submitted],
			    FILTER (
			        'fact_offer',
			        LOWER ( COALESCE ( 'fact_offer'[offer_status], "" ) ) = "draft"
