	measure 'Emergency Referrals' = ```

			CALCULATE (
			    [Total Referrals],
			    FILTER (
			        'fact_referral',
			        NOT ISBLANK ( 'fact_referral'[referral_created_date] )
			            && NOT ISBLANK ( 'fact_referral'[required_placement_date] )
			            && DATEDIFF (
			                'fact_referral'[referral_created_date],
			                'fact_referral'[required_placement_date],
			                DAY
			            ) = 0
			    )
			)

			```
		formatString: 0
		lineageTag: 55f98836-fca7-4aef-a75f-6ae7da8e3da5

	measure 'Planned Referrals' = ```

			CALCULATE (
			    [Total Referrals],
			    FILTER (
			        'fact_referral',
			        NOT ISBLANK ( 'fact_referral'[referral_created_date] )
			            && NOT ISBLANK ( 'fact_referral'[required_placement_date] )
			            && DATEDIFF (
			                'fact_referral'[referral_created_date],
			                'fact_referral'[required_placement_date],
			                DAY
			            ) > 0
			    )
			)

			```
		formatString: 0
		lineageTag: cc8458b5-c94d-4f01-a726-64b8747ab4fa

	measure 'Emergency Placement Rate' = ```

