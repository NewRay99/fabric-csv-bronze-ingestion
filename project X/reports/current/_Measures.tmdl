	/// State KPI evaluated from the retained month-end snapshot, not today's referral row.
	measure 'Closed or Cancelled Referrals at Snapshot' = ```
			CALCULATE (
				[Snapshot Referrals],
				FILTER (
					'fact_referral_snapshot',
					LOWER ( COALESCE ( 'fact_referral_snapshot'[current_status], "" ) )
						IN { "closed", "cancelled", "withdrawn", "completed" }
				)
			)
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Active Referrals Awaiting Offers at Snapshot' = ```
			CALCULATE (
				[Snapshot Referrals],
				'fact_referral_snapshot'[is_open] = TRUE (),
				'fact_referral_snapshot'[is_awaiting_offer] = TRUE ()
			)
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Active Referrals Under Offer at Snapshot' = ```
			CALCULATE (
				[Snapshot Referrals],
				'fact_referral_snapshot'[is_open] = TRUE (),
				'fact_referral_snapshot'[current_status] = "UNDER_OFFER"
			)
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Referrals With an Offer at Snapshot' = ```
			CALCULATE ( [Snapshot Referrals], 'fact_referral_snapshot'[has_offer] = TRUE () )
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Total Offers at Snapshot' = ```
			SUM ( 'fact_referral_snapshot'[offer_count] )
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Provider Contact Referrals at Snapshot' = ```
			CALCULATE (
				[Snapshot Referrals],
				FILTER (
					'fact_referral_snapshot',
					NOT ISBLANK ( 'fact_referral_snapshot'[first_action_date] )
						&& 'fact_referral_snapshot'[first_action_date]
							< 'fact_referral_snapshot'[snapshot_date] + 1
				)
			)
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Active Referrals With Provider Response at Snapshot' = ```
			CALCULATE (
				[Snapshot Referrals],
				'fact_referral_snapshot'[is_open] = TRUE (),
				'fact_referral_snapshot'[has_provider_response] = TRUE ()
			)
			```
		formatString: 0
		displayFolder: Snapshot\Month on Month

	measure 'Active Provider Response Rate at Snapshot' = ```
			VAR eligible_open_referrals =
				CALCULATE (
					[Snapshot Referrals],
					'fact_referral_snapshot'[is_open] = TRUE (),
					FILTER (
						'fact_referral_snapshot',
						NOT ISBLANK ( 'fact_referral_snapshot'[has_provider_response] )
					)
				)
			RETURN
				DIVIDE (
					[Active Referrals With Provider Response at Snapshot],
					eligible_open_referrals
				)
			```
		formatString: 0.0%
		displayFolder: Snapshot\Month on Month

