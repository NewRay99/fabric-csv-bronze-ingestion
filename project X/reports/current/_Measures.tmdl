table _Measures
	lineageTag: 712bae27-868f-4173-abe7-64ce2ab38422


	measure 'Total Referrals' = ```
			DISTINCTCOUNT ( 'fact_referral'[referral_id] )
			```
		formatString: 0
		displayFolder: Referral Volume KPIs
		lineageTag: 6323e309-be45-4771-93c9-b5940e7b3c14

	measure 'Referrals Awaiting Offer' = ```
			CALCULATE ( [Total Referrals], 'fact_referral'[is_awaiting_offer] = TRUE () )
			```
		formatString: 0
		displayFolder: Referral Volume KPIs
		lineageTag: 76689445-0377-4e72-9b3b-7b5fa4d9b1a7

	measure 'No. Providers Who Made Offers' = ```
			CALCULATE (
			    [Providers Who Made Offers],
			    FILTER ( 'fact_referral', 'fact_referral'[is_open] = TRUE () && 'fact_referral'[current_status] = "UNDER_OFFER" )
			)
			```
		formatString: 0
		displayFolder: Provider Activity KPIs
		lineageTag: fa759a7d-4361-48b4-95f4-9f9397ce05ee

	measure 'Avg Offers per Provider (Under Offer)' = ```
			DIVIDE(
			    [Offers on Referrals Under Offer],
			    [No. Providers Who Made Offers],
			    0
			)
			```
		displayFolder: Provider Activity KPIs
		lineageTag: 486d4d4c-7e13-4746-ba81-0bef2c94f802

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Successful Offers on Referrals Under Offer' = ```
			CALCULATE (
			    [Accepted Offers],
			    FILTER (
			        'fact_referral',
			        'fact_referral'[is_open] = TRUE () && 'fact_referral'[current_status] = "UNDER_OFFER"
