	measure 'Referrals Currently Active' = ```
			CALCULATE ( [Total Referrals], 'fact_referral'[is_open] = TRUE () )
			```
		formatString: 0
		displayFolder: Referral Offers
		lineageTag: c38981f9-2b39-4084-ac10-c1e7f88f3f07

	measure 'Closed or Cancelled Referrals' = ```
			CALCULATE (
			    [Total Referrals],
			    FILTER (
			        'fact_referral',
			        LOWER ( COALESCE ( 'fact_referral'[current_status], "" ) )
			            IN { "closed", "cancelled", "withdrawn", "completed" }
			    )
			)
			```
		formatString: 0
		displayFolder: Referral Offers
		lineageTag: c9646831-a1e8-4348-8da0-3729bc2aa106

	measure 'Draft No Activity Since Creation (Under Offer Referrals)' = ```
			CALCULATE (
				[Offers Submitted],
				'fact_offer'[is_draft_no_activity] = TRUE (),
				FILTER (
					'fact_referral',
					'fact_referral'[is_open] = TRUE () && 'fact_referral'[current_status] = "UNDER_OFFER"
				)
			)
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 0805fd7c-83e1-4caa-9d97-cda725926c7a

	measure 'Draft Offers With Activity Since Creation' = ```
			CALCULATE (
			    [Offers in Draft],
			    KEEPFILTERS ( 'fact_offer'[is_draft_no_activity] = FALSE () ),
			    KEEPFILTERS ( 'fact_offer'[is_draft_missing_dates] = FALSE () )
			)
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 7297ff37-222c-44ef-ac1c-119d63a20a60

	measure 'Draft Offers Missing Dates' = ```
			CALCULATE ( [Offers Submitted], 'fact_offer'[is_draft_missing_dates] = TRUE () )
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 8c7fc1d9-b83b-4eaa-9fde-0fd8a713a2bb

	measure 'Drafts No Activity 14+ Days (Under Offer Referrals)' = ```
			CALCULATE (
				[Offers Submitted],
				'fact_offer'[is_draft_no_activity] = TRUE (),
				'fact_offer'[days_since_offer_activity] >= 14,
				FILTER (
					'fact_referral',
					'fact_referral'[is_open] = TRUE () && 'fact_referral'[current_status] = "UNDER_OFFER"
				)
			)
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 32521366-3a68-49be-9571-dc02df8807ba

	measure 'Average Days in Draft' = ```
			AVERAGEX (
				FILTER (
					'fact_offer',
					LOWER ( COALESCE ( 'fact_offer'[offer_status], "" ) ) = "draft"
						&& NOT ISBLANK ( 'fact_offer'[offer_age_days] )
				),
				'fact_offer'[offer_age_days]
			)
			```
		displayFolder: Draft/Pending Offers
		lineageTag: 626c0f5e-b234-4358-a49f-338c3050cfec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Oldest Draft Age Days' = ```
			MAXX (
				FILTER (
					'fact_offer',
					LOWER ( COALESCE ( 'fact_offer'[offer_status], "" ) ) = "draft"
						&& NOT ISBLANK ( 'fact_offer'[offer_age_days] )
				),
				'fact_offer'[offer_age_days]
			)
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 074b02a5-c5f5-4e9f-a1e7-b062981aa55b

	measure 'Draft Offer Count (Under Offer Referrals)' = ```
			CALCULATE (
			    [Offers in Draft],
			    FILTER ( 'fact_referral', 'fact_referral'[is_open] = TRUE () && 'fact_referral'[current_status] = "UNDER_OFFER" )
			)
			```
		formatString: 0
		displayFolder: Draft/Pending Offers
		lineageTag: 8562c005-0e24-4fd9-a7a5-e169eaaec9db

	measure 'Providers - Fostering' = ```
			VAR framework_providers = CALCULATETABLE ( VALUES ( 'bridge_provider_framework'[provider_id] ), FILTER ( 'dim_framework', LOWER ( 'dim_framework'[placement_type] ) IN { "fostering", "plcm-fost" } ) )
			VAR home_providers = CALCULATETABLE ( VALUES ( 'dim_provider_home'[provider_id] ), FILTER ( 'dim_provider_home', LOWER ( 'dim_provider_home'[service_type] ) IN { "fostering", "plcm-fost" } ) )
			RETURN CALCULATE ( [Providers Registered], KEEPFILTERS ( TREATAS ( DISTINCT ( UNION ( framework_providers, home_providers ) ), 'dim_provider'[provider_id] ) ) )
			```
		formatString: 0
		displayFolder: Provider Registry
		lineageTag: 5a8fb78f-bb8a-4338-ab5a-00e89e70b32e

	measure 'Providers - Residential' = ```
			CALCULATE (
			    DISTINCTCOUNT ( 'dim_provider_home'[provider_id] ),
			    'dim_provider_home'[service_type] = "Residential"
			)
			```
		formatString: 0
		displayFolder: Provider Registry
		lineageTag: f2025bb7-e1a0-4551-ac06-fa769543c735

	measure 'Providers - Supported Accommodation' = ```
