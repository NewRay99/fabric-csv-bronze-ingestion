table '_Explorer KPI Measures'
	lineageTag: 90961a29-6500-59b8-9c53-a30740c9138c

	measure 'Explorer provider row visible' =
			VAR providerKey = SELECTEDVALUE('dim_provider'[provider_id])
			VAR homeFilter = ISFILTERED('dim_provider_home')
			VAR matchingHomes = CALCULATE(COUNTROWS('dim_provider_home'))
			VAR stage = SELECTEDVALUE('Journey Provider Selection'[Stage], -1)
			RETURN IF(NOT ISBLANK(providerKey) && (NOT homeFilter || matchingHomes > 0) && [Provider matches offer status] = 1 && (stage = -1 || [Journey provider stage] == stage), 1, BLANK())
		formatString: 0
		displayFolder: Explorer KPIs
		lineageTag: 332ec6fe-a1d9-54d9-aa67-9d87d04f4d98

	measure 'Explorer providers' =
			VAR unrestricted =
			    NOT ISFILTERED('Provider Offer Status'[Status])
			    && SELECTEDVALUE('Journey Provider Selection'[Stage], -1) = -1
			VAR homeFilterActive = ISFILTERED('dim_provider_home')
			VAR homeProviderIds = VALUES('dim_provider_home'[provider_id])
			VAR eligible =
			    FILTER(VALUES('dim_provider'[provider_id]),
			        NOT ISBLANK('dim_provider'[provider_id])
			        && IF(unrestricted,
			            NOT homeFilterActive || 'dim_provider'[provider_id] IN homeProviderIds,
			            CALCULATE([Explorer provider row visible]) = 1))
			RETURN CALCULATE(COALESCE(DISTINCTCOUNTNOBLANK('dim_provider'[provider_id]),0), KEEPFILTERS(eligible))
		formatString: #,0
		displayFolder: Explorer KPIs
		lineageTag: 9b82abcd-e13b-5db5-b96a-e3ad24d6535b

	measure 'Explorer providers without offers' =
			VAR unrestricted =
			    NOT ISFILTERED('Provider Offer Status'[Status])
			    && SELECTEDVALUE('Journey Provider Selection'[Stage], -1) = -1
			VAR homeFilterActive = ISFILTERED('dim_provider_home')
			VAR homeProviderIds = VALUES('dim_provider_home'[provider_id])
			VAR eligible =
			    FILTER(VALUES('dim_provider'[provider_id]),
			        NOT ISBLANK('dim_provider'[provider_id])
			        && IF(unrestricted,
			            NOT homeFilterActive || 'dim_provider'[provider_id] IN homeProviderIds,
			            CALCULATE([Explorer provider row visible]) = 1))
			RETURN CALCULATE(COUNTROWS(FILTER(VALUES('dim_provider'[provider_id]), CALCULATE([Explorer provider offers]) = 0)), KEEPFILTERS(eligible))
		formatString: #,0
		displayFolder: Explorer KPIs
		lineageTag: e6f3c6ae-6aa9-5f7d-9abc-e52f136327fa

	measure 'Explorer provider assignment row visible' = IF([Explorer provider row visible] = 1 && COUNTROWS('fact_referral_provider') > 0, 1, BLANK())
		formatString: 0
		displayFolder: Explorer KPIs
		lineageTag: 9530a038-9d2e-536f-abc6-11f5b217ceb4

	measure 'Explorer provider offer row visible' =

			IF (
			    COUNTROWS ( 'fact_offer' ) > 0,
			    IF (
			        [Explorer provider row visible] = 1,
			        1,
			        BLANK ()
			    ),
			    BLANK ()
			)
		formatString: 0
		displayFolder: Explorer KPIs
		lineageTag: cd9d5285-b4e3-5ec3-96f5-c3d63aa25bdf

	measure 'Explorer provider message row visible' = IF([Explorer provider row visible] = 1 && COUNTROWS('dim_referral_provider_message') > 0, 1, BLANK())
		formatString: 0
		displayFolder: Explorer KPIs
		lineageTag: d463284c-d7a2-56a1-8b7d-f355225e0241

	measure 'Explorer provider monthly row visible' = IF([Explorer provider row visible] = 1 && COUNTROWS('fact_provider_kpi_monthly') > 0, 1, BLANK())
		formatString: 0
		displayFolder: Explorer KPIs
		lineageTag: ea8a25f4-4503-5ca3-acff-da4c138f8d70

	measure 'Explorer provider homes' =
			VAR unrestricted =
			    NOT ISFILTERED('Provider Offer Status'[Status])
			    && SELECTEDVALUE('Journey Provider Selection'[Stage], -1) = -1
			VAR homeFilterActive = ISFILTERED('dim_provider_home')
			VAR homeProviderIds = VALUES('dim_provider_home'[provider_id])
			VAR eligible =
			    FILTER(VALUES('dim_provider'[provider_id]),
			        NOT ISBLANK('dim_provider'[provider_id])
			        && IF(unrestricted,
			            NOT homeFilterActive || 'dim_provider'[provider_id] IN homeProviderIds,
			            CALCULATE([Explorer provider row visible]) = 1))
			RETURN CALCULATE(COALESCE(DISTINCTCOUNTNOBLANK('dim_provider_home'[provider_home_id]),0), KEEPFILTERS(eligible))
		formatString: #,0
		displayFolder: Explorer KPIs
		lineageTag: fa30d3df-f819-5454-b823-229d7b6da673

	measure 'Explorer provider beds' =
